#!/bin/sh
set -e

# Cria o diretorio de config e, na primeira instalacao, copia o exemplo.
if [ ! -d /etc/asterisk-pn ]; then
    install -d -m 0750 /etc/asterisk-pn
fi

if [ ! -f /etc/asterisk-pn/push.env ]; then
    cp /etc/asterisk-pn/push.env.example /etc/asterisk-pn/push.env
    chmod 0600 /etc/asterisk-pn/push.env
    echo "[asterisk-pn] criado /etc/asterisk-pn/push.env (edite as credenciais)"
else
    echo "[asterisk-pn] /etc/asterisk-pn/push.env ja existe (mantido)"
fi

echo "[asterisk-pn] binario instalado em /usr/local/bin/asterisk-pn"
echo "[asterisk-pn] veja /usr/share/doc/asterisk-pn/README.md"
exit 0
