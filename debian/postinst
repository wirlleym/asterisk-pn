#!/bin/sh
set -e

# Cria o diretorio de config e, na primeira instalacao, copia o exemplo.
if [ ! -d /etc/asterisk-push-notify ]; then
    install -d -m 0750 /etc/asterisk-push-notify
fi

if [ ! -f /etc/asterisk-push-notify/push.env ]; then
    cp /etc/asterisk-push-notify/push.env.example /etc/asterisk-push-notify/push.env
    chmod 0600 /etc/asterisk-push-notify/push.env
    echo "[asterisk-push-notify] criado /etc/asterisk-push-notify/push.env (edite as credenciais)"
else
    echo "[asterisk-push-notify] /etc/asterisk-push-notify/push.env ja existe (mantido)"
fi

echo "[asterisk-push-notify] binario instalado em /usr/local/bin/asterisk-pn"
echo "[asterisk-push-notify] veja /usr/share/doc/asterisk-push-notify/README.md"
exit 0
