# push.env.example — config do CLI asterisk-pn
#
# Copie para /etc/asterisk-push-notify/push.env e preencha os placeholders <...>.
# O CLI le esse arquivo (ou as variaveis de ambiente) ao ser chamado pelo dialplan.

# Arquivo onde ficam os tokens (ramal <-> token)
PUSH_DATA_FILE=/etc/asterisk-push-notify/devices.json

# APNs (iOS) — chave .p8 + Key ID + Team ID da conta Apple
APNS_KEY_PATH=/etc/asterisk-push-notify/AuthKey.p8
APNS_KEY_ID=<KEY_ID>
APNS_TEAM_ID=<TEAM_ID>
# Topico de VoIP = <bundle-id do app>.voip
APNS_TOPIC=<BUNDLE_ID>.voip
# sandbox (build de dev) | production (TestFlight/App Store)
APNS_ENVIRONMENT=production

# FCM (Android) — opcional: caminho do service account JSON
# FCM_SERVICE_ACCOUNT_JSON=/etc/asterisk-push-notify/fcm-service-account.json
